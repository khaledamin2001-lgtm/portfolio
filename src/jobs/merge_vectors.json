{
  "about": "Shared test vectors for the engine store's write semantics (src/jobs/store.py is the reference; the site editor's JS copy must pass the same file). Compare results with order-insensitive deep equality: JS reorders integer-like object keys, and Python keeps insertion order. Numbers here are all safe integers or plain decimals so JS and Python agree. merge: deep_merge(base, patch) == expect (base and patch must be left unmodified). set: the stored data of a 'set' write is strip_markers(data) == expect. batches: start from 'docs' (\"collection/doc\" -> {version, data}), apply 'writes' in order as ONE all-or-nothing batch; then either 'expect' (results = [{status, version}] per write, docs = final state; absent docs omitted) or 'expectError' (the batch raises and 'docs' must be left exactly as they were).",
  "merge": [
    {"name": "adds a new key", "base": {"a": 1}, "patch": {"b": 2}, "expect": {"a": 1, "b": 2}},
    {"name": "scalar replaces scalar", "base": {"a": 1, "b": "x"}, "patch": {"a": 2}, "expect": {"a": 2, "b": "x"}},
    {"name": "objects merge recursively", "base": {"s": {"x": 1, "y": 2}}, "patch": {"s": {"y": 3, "z": 4}}, "expect": {"s": {"x": 1, "y": 3, "z": 4}}},
    {"name": "three levels deep", "base": {"a": {"b": {"c": 1, "d": 2}, "e": 5}}, "patch": {"a": {"b": {"d": 3}}}, "expect": {"a": {"b": {"c": 1, "d": 3}, "e": 5}}},
    {"name": "arrays replace, never concatenate", "base": {"rows": [1, 2, 3]}, "patch": {"rows": [4]}, "expect": {"rows": [4]}},
    {"name": "arrays of objects replace whole (no element merge)", "base": {"rows": [{"a": 1, "b": 2}]}, "patch": {"rows": [{"a": 9}]}, "expect": {"rows": [{"a": 9}]}},
    {"name": "empty array replaces", "base": {"rows": [1]}, "patch": {"rows": []}, "expect": {"rows": []}},
    {"name": "null replaces an object (null is a value, not a delete)", "base": {"a": {"x": 1}}, "patch": {"a": null}, "expect": {"a": null}},
    {"name": "null can be added", "base": {}, "patch": {"a": null}, "expect": {"a": null}},
    {"name": "object replaces null", "base": {"a": null}, "patch": {"a": {"x": 1}}, "expect": {"a": {"x": 1}}},
    {"name": "delete marker removes a key", "base": {"a": 1, "b": 2}, "patch": {"a": {"__delete__": true}}, "expect": {"b": 2}},
    {"name": "delete marker on an absent key is a no-op", "base": {"b": 2}, "patch": {"a": {"__delete__": true}}, "expect": {"b": 2}},
    {"name": "nested delete marker", "base": {"s": {"x": 1, "y": 2}}, "patch": {"s": {"x": {"__delete__": true}}}, "expect": {"s": {"y": 2}}},
    {"name": "delete marker removes a whole nested object", "base": {"s": {"x": 1}, "t": 1}, "patch": {"s": {"__delete__": true}}, "expect": {"t": 1}},
    {"name": "delete marker with extra keys still deletes", "base": {"a": 1}, "patch": {"a": {"__delete__": true, "ignored": 1}}, "expect": {}},
    {"name": "__delete__ false is an ordinary field", "base": {"a": {"x": 1}}, "patch": {"a": {"__delete__": false}}, "expect": {"a": {"x": 1, "__delete__": false}}},
    {"name": "__delete__ as the string 'true' is an ordinary field", "base": {}, "patch": {"a": {"__delete__": "true"}}, "expect": {"a": {"__delete__": "true"}}},
    {"name": "delete and set in the same patch", "base": {"a": 1, "b": 2}, "patch": {"a": {"__delete__": true}, "c": 3}, "expect": {"b": 2, "c": 3}},
    {"name": "object patch over a scalar starts from {}", "base": {"a": 5}, "patch": {"a": {"x": 1}}, "expect": {"a": {"x": 1}}},
    {"name": "object patch over an array starts from {}", "base": {"a": [1, 2]}, "patch": {"a": {"x": 1}}, "expect": {"a": {"x": 1}}},
    {"name": "array replaces an object", "base": {"a": {"x": 1}}, "patch": {"a": [1]}, "expect": {"a": [1]}},
    {"name": "scalar replaces an object", "base": {"a": {"x": 1}}, "patch": {"a": "flat"}, "expect": {"a": "flat"}},
    {"name": "empty patch changes nothing", "base": {"a": 1, "s": {"x": 1}}, "patch": {}, "expect": {"a": 1, "s": {"x": 1}}},
    {"name": "empty object on a missing key creates it", "base": {}, "patch": {"a": {}}, "expect": {"a": {}}},
    {"name": "empty object on an existing object keeps it", "base": {"a": {"x": 1}}, "patch": {"a": {}}, "expect": {"a": {"x": 1}}},
    {"name": "markers inside a new nested object are dropped", "base": {}, "patch": {"a": {"x": {"__delete__": true}, "y": 1}}, "expect": {"a": {"y": 1}}},
    {"name": "markers inside arrays are kept verbatim", "base": {}, "patch": {"rows": [{"__delete__": true}, 1]}, "expect": {"rows": [{"__delete__": true}, 1]}},
    {"name": "type changes: boolean to number", "base": {"a": true}, "patch": {"a": 0}, "expect": {"a": 0}},
    {"name": "false and 0 and empty string are values", "base": {"a": 1, "b": 1, "c": 1}, "patch": {"a": false, "b": 0, "c": ""}, "expect": {"a": false, "b": 0, "c": ""}},
    {"name": "decimals survive", "base": {"px": 12.5}, "patch": {"px": 12.75, "q": -0.001}, "expect": {"px": 12.75, "q": -0.001}},
    {"name": "unicode strings", "base": {"name": "Portfolio"}, "patch": {"name": "محفظة ياسين", "note": "é — ✓"}, "expect": {"name": "محفظة ياسين", "note": "é — ✓"}},
    {"name": "month-keyed maps merge per month (marks shape)", "base": {"months": {"2026-07": {"AAA": 1.5, "BBB": 2}, "2026-08": {"AAA": 1.6}}}, "patch": {"months": {"2026-08": {"BBB": 2.1}, "2026-09": {"AAA": 1.7}}}, "expect": {"months": {"2026-07": {"AAA": 1.5, "BBB": 2}, "2026-08": {"AAA": 1.6, "BBB": 2.1}, "2026-09": {"AAA": 1.7}}}},
    {"name": "integer-like keys merge (order may differ in JS)", "base": {"m": {"10": 1, "2": 2}}, "patch": {"m": {"1": 0, "10": 5}}, "expect": {"m": {"1": 0, "2": 2, "10": 5}}},
    {"name": "deleting an asset from a map of assets", "base": {"items": {"COMI": {"name": "x", "stop": 10}, "ETEL": {"name": "y"}}}, "patch": {"items": {"COMI": {"stop": {"__delete__": true}}, "ETEL": {"__delete__": true}}}, "expect": {"items": {"COMI": {"name": "x"}}}}
  ],
  "set": [
    {"name": "plain data is stored as is", "data": {"a": 1, "s": {"x": [1, 2]}}, "expect": {"a": 1, "s": {"x": [1, 2]}}},
    {"name": "top-level delete markers are dropped", "data": {"a": 1, "b": {"__delete__": true}}, "expect": {"a": 1}},
    {"name": "nested delete markers are dropped", "data": {"s": {"x": {"__delete__": true}, "y": 2}}, "expect": {"s": {"y": 2}}},
    {"name": "set keeps markers inside arrays verbatim", "data": {"rows": [{"__delete__": true}]}, "expect": {"rows": [{"__delete__": true}]}},
    {"name": "empty object", "data": {}, "expect": {}}
  ],
  "batches": [
    {"name": "set creates a new doc at version 1", "docs": {},
     "writes": [{"op": "set", "collection": "portfolio", "doc_id": "settings", "data": {"a": 1}}],
     "expect": {"results": [{"status": "created", "version": 1}], "docs": {"portfolio/settings": {"version": 1, "data": {"a": 1}}}}},
    {"name": "set replaces the whole doc and bumps the version", "docs": {"portfolio/settings": {"version": 4, "data": {"a": 1, "b": 2}}},
     "writes": [{"op": "set", "collection": "portfolio", "doc_id": "settings", "data": {"c": 3}}],
     "expect": {"results": [{"status": "updated", "version": 5}], "docs": {"portfolio/settings": {"version": 5, "data": {"c": 3}}}}},
    {"name": "update deep-merges and bumps the version", "docs": {"portfolio/marks": {"version": 2, "data": {"months": {"2026-08": {"AAA": 1}}}}},
     "writes": [{"op": "update", "collection": "portfolio", "doc_id": "marks", "data": {"months": {"2026-09": {"AAA": 2}}}}],
     "expect": {"results": [{"status": "updated", "version": 3}], "docs": {"portfolio/marks": {"version": 3, "data": {"months": {"2026-08": {"AAA": 1}, "2026-09": {"AAA": 2}}}}}}},
    {"name": "update that changes nothing keeps the version (unchanged)", "docs": {"sync/state": {"version": 7, "data": {"seen": ["a", "b"], "n": 1}}},
     "writes": [{"op": "update", "collection": "sync", "doc_id": "state", "data": {"n": 1, "gone": {"__delete__": true}}}],
     "expect": {"results": [{"status": "unchanged", "version": 7}], "docs": {"sync/state": {"version": 7, "data": {"seen": ["a", "b"], "n": 1}}}}},
    {"name": "set with identical data is unchanged", "docs": {"bench/egx30": {"version": 3, "data": {"members": ["X"]}}},
     "writes": [{"op": "set", "collection": "bench", "doc_id": "egx30", "data": {"members": ["X"]}}],
     "expect": {"results": [{"status": "unchanged", "version": 3}], "docs": {"bench/egx30": {"version": 3, "data": {"members": ["X"]}}}}},
    {"name": "a changed number type is a change (1 vs true)", "docs": {"sync/state": {"version": 1, "data": {"f": 1}}},
     "writes": [{"op": "update", "collection": "sync", "doc_id": "state", "data": {"f": true}}],
     "expect": {"results": [{"status": "updated", "version": 2}], "docs": {"sync/state": {"version": 2, "data": {"f": true}}}}},
    {"name": "update on a missing doc creates it from {}", "docs": {},
     "writes": [{"op": "update", "collection": "imports", "doc_id": "2026-09", "data": {"monthly": {"posted": true}, "x": {"__delete__": true}}}],
     "expect": {"results": [{"status": "created", "version": 1}], "docs": {"imports/2026-09": {"version": 1, "data": {"monthly": {"posted": true}}}}}},
    {"name": "if_version that matches is accepted", "docs": {"ledger/y2026": {"version": 12, "data": {"rows": [1]}}},
     "writes": [{"op": "set", "collection": "ledger", "doc_id": "y2026", "data": {"rows": [1, 2]}, "if_version": 12}],
     "expect": {"results": [{"status": "updated", "version": 13}], "docs": {"ledger/y2026": {"version": 13, "data": {"rows": [1, 2]}}}}},
    {"name": "if_version 0 means must not exist (and it does not)", "docs": {},
     "writes": [{"op": "set", "collection": "history", "doc_id": "2026-10", "data": {"d": {}}, "if_version": 0}],
     "expect": {"results": [{"status": "created", "version": 1}], "docs": {"history/2026-10": {"version": 1, "data": {"d": {}}}}}},
    {"name": "a second write to the same doc sees the version the first produced", "docs": {"portfolio/assets": {"version": 1, "data": {"items": {}}}},
     "writes": [{"op": "update", "collection": "portfolio", "doc_id": "assets", "data": {"items": {"A": {"n": 1}}}, "if_version": 1},
                {"op": "update", "collection": "portfolio", "doc_id": "assets", "data": {"items": {"B": {"n": 2}}}, "if_version": 2}],
     "expect": {"results": [{"status": "updated", "version": 2}, {"status": "updated", "version": 3}], "docs": {"portfolio/assets": {"version": 3, "data": {"items": {"A": {"n": 1}, "B": {"n": 2}}}}}}},
    {"name": "delete removes an existing doc", "docs": {"market/latest": {"version": 9, "data": {"a": 1}}, "bench/egx30": {"version": 1, "data": {"b": 1}}},
     "writes": [{"op": "delete", "collection": "market", "doc_id": "latest"}],
     "expect": {"results": [{"status": "deleted", "version": 9}], "docs": {"bench/egx30": {"version": 1, "data": {"b": 1}}}}},
    {"name": "delete of an absent doc is 'absent'", "docs": {},
     "writes": [{"op": "delete", "collection": "market", "doc_id": "latest"}],
     "expect": {"results": [{"status": "absent", "version": 0}], "docs": {}}},
    {"name": "delete then set in one batch recreates at version 1", "docs": {"market/latest": {"version": 9, "data": {"a": 1}}},
     "writes": [{"op": "delete", "collection": "market", "doc_id": "latest"}, {"op": "set", "collection": "market", "doc_id": "latest", "data": {"a": 2}, "if_version": 0}],
     "expect": {"results": [{"status": "deleted", "version": 9}, {"status": "created", "version": 1}], "docs": {"market/latest": {"version": 1, "data": {"a": 2}}}}},
    {"name": "if_version mismatch raises and nothing in the batch is written", "docs": {"portfolio/settings": {"version": 3, "data": {"a": 1}}, "portfolio/marks": {"version": 5, "data": {"m": 1}}},
     "writes": [{"op": "update", "collection": "portfolio", "doc_id": "settings", "data": {"a": 2}, "if_version": 3},
                {"op": "update", "collection": "portfolio", "doc_id": "marks", "data": {"m": 2}, "if_version": 4}],
     "expectError": {"type": "version_conflict", "collection": "portfolio", "doc_id": "marks", "expected": 4, "actual": 5}},
    {"name": "if_version 0 on an existing doc raises", "docs": {"history/2026-09": {"version": 2, "data": {}}},
     "writes": [{"op": "set", "collection": "history", "doc_id": "2026-09", "data": {"x": 1}, "if_version": 0}],
     "expectError": {"type": "version_conflict", "collection": "history", "doc_id": "2026-09", "expected": 0, "actual": 2}},
    {"name": "if_version on a missing doc raises (actual 0)", "docs": {},
     "writes": [{"op": "update", "collection": "sync", "doc_id": "state", "data": {"x": 1}, "if_version": 1}],
     "expectError": {"type": "version_conflict", "collection": "sync", "doc_id": "state", "expected": 1, "actual": 0}},
    {"name": "within a batch, pinning the pre-batch version on a second write conflicts", "docs": {"sync/state": {"version": 1, "data": {"n": 0}}},
     "writes": [{"op": "update", "collection": "sync", "doc_id": "state", "data": {"n": 1}, "if_version": 1},
                {"op": "update", "collection": "sync", "doc_id": "state", "data": {"n": 2}, "if_version": 1}],
     "expectError": {"type": "version_conflict", "collection": "sync", "doc_id": "state", "expected": 1, "actual": 2}},
    {"name": "a bad doc name rejects the whole batch", "docs": {"sync/state": {"version": 1, "data": {"n": 0}}},
     "writes": [{"op": "update", "collection": "sync", "doc_id": "state", "data": {"n": 1}},
                {"op": "set", "collection": "sync", "doc_id": "../../config", "data": {}}],
     "expectError": {"type": "invalid"}},
    {"name": "a bad op rejects the whole batch", "docs": {},
     "writes": [{"op": "merge", "collection": "sync", "doc_id": "state", "data": {}}],
     "expectError": {"type": "invalid"}},
    {"name": "set/update data must be an object", "docs": {},
     "writes": [{"op": "set", "collection": "sync", "doc_id": "state", "data": [1, 2]}],
     "expectError": {"type": "invalid"}}
  ]
}
