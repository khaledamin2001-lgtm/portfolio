rules_version = '2';
// Firestore security rules for the portfolio site's accounts (project portfolio-desk-4d14a).
// Paste into Firebase console -> Firestore Database -> Rules -> Publish, with OWNER@EXAMPLE.COM below replaced by the
// site owner's sign-in email in lower case (kept out of this public file). The site stores only ENCRYPTED blobs here:
// every portfolio document is sealed in the browser to the account's own key, so these rules decide who can touch
// the ciphertext, not who can read the figures.
service cloud.firestore {
  match /databases/{database}/documents {
    // The site owner (admin screen): signed in with this email, verified. Sees the status list, can reset an account.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'owner@example.com' && request.auth.token.email_verified == true;
    }
    function me(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // An account's profile (public key + its private key wrapped by the password and by the recovery code) and its
    // encrypted documents: only that account. The admin may list profiles (the admin screen asks for the name and join
    // date only) and delete them (reset / delete); it cannot open the documents (they are encrypted to the account's key).
    match /users/{uid} {
      allow read, write: if me(uid);
      allow read, delete: if isAdmin();
      match /docs/{docId} {
        allow read, write: if me(uid);
        allow read, delete: if isAdmin();
      }
    }
    // The members key for the shared market data: its public half is readable by anyone (the daily price job encrypts
    // with it), its private half only by signed-in members. Each is created once and can never be changed or deleted.
    match /shared/membersPub {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    match /shared/members {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    // Email updates (opt-in): an account's package for the site owner's email job, sealed in the browser to the mail key,
    // so anyone may fetch it (the job reads it without signing in) but nobody else can open it; only the account writes it.
    match /mail/{uid} {
      allow read: if true;
      allow write: if me(uid);
      allow delete: if isAdmin();
    }
    // Status for the admin screen: no figures, only name, email, dates and whether the automatic updates work. Written by
    // the account (the site, and the email job signed in as the account); read by the account and the admin.
    match /status/{uid} {
      allow read: if me(uid) || isAdmin();
      allow write: if me(uid);
      allow delete: if isAdmin();
    }
    // Find a friend by email: directory/{email} = {uid, name, pub}. Only the owner of that sign-in email writes it, and
    // only once Google has verified the email (so nobody can sign up with someone else's email and catch their friend
    // requests); any signed-in account can fetch one by its exact email, nobody can list them.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    match /directory/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if verified() && request.auth.token.email == email && request.resource.data.uid == request.auth.uid;
      allow delete: if (request.auth != null && request.auth.token.email == email) || isAdmin();
    }
    // Find a friend by @username: handles/{handle} = {uid, name, pub, at}. A username is 3-20 lower-case letters, digits or
    // "_", starting with a letter. Only a verified account can take one, only for itself and with the key of its own
    // directory entry; one already taken can never be taken over (creating needs it free, changing needs it to be yours).
    // Any signed-in account can fetch one by its exact name, nobody can list them; the account or the admin deletes it.
    match /handles/{handle} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if verified() && handle.matches('^[a-z][a-z0-9_]{2,19}$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.pub == get(/databases/$(database)/documents/directory/$(request.auth.token.email)).data.pub;
      allow update: if verified() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid
                    && request.resource.data.pub == get(/databases/$(database)/documents/directory/$(request.auth.token.email)).data.pub;
      allow delete: if (request.auth != null && resource.data.uid == request.auth.uid) || isAdmin();
    }
    // Friends. links/{uid}/with/{other} is uid's side: {status: sent | received | friends, name, pub, email, handle, at}.
    // Asking writes both sides (mine 'sent', theirs 'received'); only the one who received it can make both 'friends';
    // either can delete both (decline, cancel, remove). Nothing else about a link can change. The asker must have a
    // verified email, and the 'received' side it writes must carry the asker's own email and the key of the asker's own
    // directory entry, so a request cannot pose as someone else (the site checks the same before sharing anything).
    // A request sent to an @username has no email on the asker's side; whoever accepts adds their OWN verified email to
    // it, so from then on the friendship is checked by email and a later change of username does not break it.
    match /links/{uid}/with/{other} {
      allow read: if me(uid) || isAdmin();
      allow create: if (me(uid) && verified() && request.resource.data.status == 'sent')
                    || (me(other) && verified() && request.resource.data.status == 'received'
                        && request.resource.data.email == request.auth.token.email
                        && request.resource.data.pub == get(/databases/$(database)/documents/directory/$(request.auth.token.email)).data.pub);
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at', 'email'])
                    && request.resource.data.status == 'friends'
                    && ((me(other) && resource.data.status == 'sent'
                         && (request.resource.data.get('email', '') == resource.data.get('email', '')
                             || (verified() && request.resource.data.email == request.auth.token.email)))
                        || (me(uid) && resource.data.status == 'received'
                            && request.resource.data.get('email', '') == resource.data.get('email', '')));
      allow delete: if me(uid) || me(other) || isAdmin();
    }
    // What a friend sees: shares/{owner}/to/{viewer} = {pkg: a copy of the owner's portfolio sealed to the viewer's key,
    // name, at}. Only the owner writes it, and only while the two are friends; either can delete it.
    match /shares/{owner}/to/{viewer} {
      allow read: if me(owner) || me(viewer) || isAdmin();
      allow write: if me(owner) && get(/databases/$(database)/documents/links/$(owner)/with/$(viewer)).data.status == 'friends';
      allow delete: if me(owner) || me(viewer) || isAdmin();
    }
    // An account the site owner deleted: its data is wiped at once; this marker makes the sign-in delete itself the next
    // time it is used (only an account can delete its own sign-in).
    match /deleted/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create: if isAdmin();
      allow delete: if me(uid) || isAdmin();
    }
    // Everything else: nobody.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
